# .env.example — Copy this file to .env and fill in real values.
# Never commit the actual .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Auto Tender Writer"
APP_VERSION="0.1.0"
ENVIRONMENT="development"       # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a long, cryptographically random string in production.
SECRET_KEY="CHANGE_ME_use_openssl_rand_-hex_32"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (SQLite, no server needed):
DATABASE_URL="sqlite+aiosqlite:///./auto_tender_writer.db"
# Production (PostgreSQL — uncomment and fill):
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/auto_tender_writer"

# ── Celery / Redis ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE provider by setting LLM_PROVIDER and the matching credentials.

# ── Option A: Google Gemini (recommended — fast, 1M context, cheap) ───────────
LLM_PROVIDER=gemini
GEMINI_API_KEY="AIzaSyAm4kkEE94G0w9u2nOpFnzqeCTwiSBpXAs"
GEMINI_MODEL=gemini-2.0-flash
# Also set these for non-Gemini calls (e.g. fallback or concurrent services):
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT=120

# ── Option B: Local Ollama (uncomment to use) ────────────────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_API_KEY="ollama"
# LLM_MODEL="kimi-k2"

# ── Option C: OpenAI (uncomment to use) ───────────────────────────────
# LLM_PROVIDER=openai
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o"

# ── Evaluation Thresholds (business rules enforced by Python) ─────────────────
LATE_SUBMISSION_TOLERANCE_SECONDS=0
ABNORMALLY_LOW_PRICE_THRESHOLD_PCT=15.0
CLOSE_TIE_THRESHOLD_PCT=3.0
DEFAULT_TECHNICAL_WEIGHT=0.70

# ── Email / Notifications ─────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@autotenderwriter.local"
